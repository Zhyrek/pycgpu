      given-names: Zi-Kui
  title: "pycalphad: CALPHAD-based Computational Thermodynamics in Python"
  journal: Journal of Open Research Software
  volume: 5
  issue: 1
  start: 1
  year: 2017
  doi: 10.5334/jors.140
